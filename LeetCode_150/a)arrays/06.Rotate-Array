https://leetcode.com/problems/rotate-array/?envType=study-plan-v2&envId=top-interview-150

class Solution {

    public void rotate(int[] nums, int k) {

        int n = nums.length;

        if (n == 0 || k==0) {
            return;
        }

        k = k % n;

        reverse(nums, 0, n - 1);
        reverse(nums, 0, k - 1);
        reverse(nums, k, n - 1);
    }

    public void reverse(int[] arr, int st, int ed) {

        while (st <= ed) {
            int temp = arr[ed];
            arr[ed] = arr[st];
            arr[st] = temp;

            st++;
            ed--;
        }
    }
}