//https://leetcode.com/problems/length-of-last-word/?envType=study-plan-v2&envId=top-interview-150

//Tc: O(N); Sc: O(1)

class Solution {
    public int lengthOfLastWord(String s) {
        int ct=0;

        for(int i=s.length()-1; i>=0; i--){
            if(s.charAt(i)!= ' ')
                ct++;
            else {
                if(ct>0)
                return ct;
            }
        }

        return ct;
    }
}