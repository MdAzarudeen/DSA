//https://leetcode.com/problems/set-matrix-zeroes/description/?envType=study-plan-v2&envId=top-interview-150

class Solution {
    public void setZeroes(int[][] arr) {
        int n = arr.length;
        int m = arr[0].length;
        boolean firstRowZero = false;
        boolean firstColumnZero = false;
//check if any zero exists in first row
        for(int i=0; i<m; i++){
            if(arr[0][i]==0) {
                firstRowZero=true;
                break;
            }
        }
//check if any zero exists in first column
        for(int i=0; i<n; i++){
            if(arr[i][0]==0){
                firstColumnZero=true;
                break;
            }
        }
//if any zero found in any rows or columns, mark its first row/col as 0
        for(int i=1; i<n; i++){
            for(int j=1; j<m; j++){
                if(arr[i][j]==0){
                    arr[i][0]=0;
                    arr[0][j]=0;
                }
            }
        }
//for any zeros in first row/col, mark its adjacent element as 0
         for(int i=1; i<n; i++){
            for(int j=1; j<m; j++){
                if(arr[i][0]==0 || arr[0][j]==0){
                    arr[i][j]=0;
                }
            }
         }
//if first row/col has any zero, mark its entire row/col as 0
        if(firstRowZero){
            for(int i=0; i<m; i++)
                arr[0][i]=0;
        }
        if(firstColumnZero){
            for(int i=0; i<n; i++)
                arr[i][0]=0;
        }
    }
}