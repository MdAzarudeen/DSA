class Solution {
    public int removeElement(int[] nums, int val) {
        int i = nums.length-1;
        int j = nums.length-1;
        int k = 0;
        while(i>=0){
            if(nums[i]==val){
                swap(i, j, nums);
                i--; j--;
            }
            else{
                i--;
            }
        }
        return j+1;
    }
    public void swap(int a, int b, int[] nums){
        int temp = nums[a];
        nums[a]=nums[b];
        nums[b]= temp;
    }
}