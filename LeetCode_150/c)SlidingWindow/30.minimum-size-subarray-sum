//This is Variable sliding window problem as size of the windows keeps changing

////Tc: O(N) , Sc: O(1)

class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        int minLenWindow = Integer.MAX_VALUE;
        int sum = 0;

        //2 pointers
        int low =0; int high = 0;

        while(high<nums.length){
            sum += nums[high];
            high++;

            while(sum>=target){
                int curLenWindow = high - low;
                minLenWindow = Math.min(minLenWindow , curLenWindow);
                sum -= nums[low];
                low++;
            }
        }
        return minLenWindow == Integer.MAX_VALUE ? 0 : minLenWindow;
    }
}